#!/usr/bin/env bash
# msixrun - install and launch an MSIX/APPX package from bash on Windows.
set -euo pipefail

VERSION="1.1.1"

usage() {
  cat <<USAGE
msixrun $VERSION - install and launch an MSIX package from bash on Windows

Usage: msixrun <file-or-url.msix|.msixbundle|.appx|.appxbundle> [options]

The package can be a local file or an http(s) URL (it is downloaded first).

Options:
  --no-launch   install only, do not start the app
  --trust       if Windows does not trust the package's publisher, trust that
                one publisher certificate (this PC only) without asking
  -y, --yes     answer yes to every question (trust the publisher, remove an
                older copy from a different publisher, install unsigned when
                Developer Mode allows it)
  -h, --help    show this help
  --version     show version
USAGE
}

die() { echo "msixrun: error: $*" >&2; exit 1; }

# Run a PowerShell script text. Scripts below use single quotes only, so the
# text survives the Windows command line unchanged.
ps() { powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$1" | tr -d '\r'; }

# Quote a value for use inside a PowerShell single-quoted string. PowerShell
# also treats the curly single quotes U+2018 to U+201B as quote characters, so
# those are doubled too.
psq() {
  local s="$1" q sq="'"
  s=${s//"$sq"/$sq$sq}
  for q in $'\xe2\x80\x98' $'\xe2\x80\x99' $'\xe2\x80\x9a' $'\xe2\x80\x9b'; do
    s=${s//"$q"/$q$q}
  done
  printf '%s' "$s"
}

# ---- PowerShell snippets. Fixed text; the only values ever spliced in are the
# ---- package path, through psq, and (for the trust step) the signer's SHA-1
# ---- thumbprint, which bash has checked to be 40 uppercase hex characters.
# ---- No other text read from the package is spliced in.

ps_id_fn() {
  cat <<'PS'
function Get-MsixId($p) {
  Add-Type -AssemblyName System.IO.Compression.FileSystem
  $zip = [IO.Compression.ZipFile]::OpenRead($p)
  try {
    $e = $zip.Entries | Where-Object { $_.FullName -in 'AppxManifest.xml','AppxMetadata/AppxBundleManifest.xml' } | Select-Object -First 1
    if (-not $e) { throw 'no AppxManifest.xml or AppxBundleManifest.xml found in package' }
    $r = New-Object IO.StreamReader($e.Open())
    try { [xml]$x = $r.ReadToEnd() } finally { $r.Dispose() }
    if ($x.Package) { $x.Package.Identity } else { $x.Bundle.Identity }
  } finally { $zip.Dispose() }
}
PS
}

ps_manifest() {
  ps_id_fn
  cat <<'PS'
# step: manifest
$ErrorActionPreference = 'Stop'
$i = Get-MsixId $pkg
'NAME=' + $i.Name
'PUBLISHER=' + $i.Publisher
PS
}

ps_install() {
  cat <<'PS'
# step: install
$ErrorActionPreference = 'Stop'
try {
  if ($allowUnsigned) { Add-AppxPackage -Path $pkg -AllowUnsigned } else { Add-AppxPackage -Path $pkg }
  'MSIXRUN_OK'
} catch {
  $h = [BitConverter]::ToUInt32([BitConverter]::GetBytes([int]$_.Exception.HResult), 0)
  # The .NET exception's HResult. It is NOT the deployment HRESULT (that is in
# the message), so bash uses it only when the message holds no code.
'MSIXRUN_HRESULT=0x{0:X8}' -f $h
  'MSIXRUN_MESSAGE=' + (($_.Exception.Message + ' ' + $_.FullyQualifiedErrorId) -replace '\s+', ' ')
  exit 1
}
PS
}

ps_signer() {
  cat <<'PS'
# step: signer
$ErrorActionPreference = 'Stop'
function Clean($s, $max) { $t = ([string]$s) -replace '[\p{Cc}\p{Cf}]', '?'; if ($t.Length -gt $max) { $t.Substring(0, $max) + '...' } else { $t } }
$sig = Get-AuthenticodeSignature -FilePath $pkg
'STATUS=' + $sig.Status
$c = $sig.SignerCertificate
if ($c) {
  'SUBJECT=' + (Clean $c.Subject 200)
  'THUMBPRINT=' + (Clean $c.Thumbprint 64)
  'NOTAFTER=' + $c.NotAfter.ToString('yyyy-MM-dd')
}
PS
}

# Import THIS package's signer certificate into LocalMachine\TrustedPeople in
# one elevated child. $expectedThumb is the thumbprint the user was shown. The
# signer is read again here and nothing happens unless its thumbprint equals
# $expectedThumb and its status is still UnknownError or NotTrusted. The
# certificate is exported to a temp .cer by this non-elevated side; the elevated
# child gets only that path and the thumbprint (through -EncodedCommand, Base64
# of UTF-16LE, so no text is parsed as part of a command line), reloads the
# file, recomputes the thumbprint and refuses unless it matches.
ps_trust() {
  cat <<'PS'
# step: trust
$ErrorActionPreference = 'Stop'
function Q($s) { [regex]::Replace($s, '([''‘’‚‛])', '$1$1') }
function Declined($e) {
  while ($e) {
    if (($e -is [ComponentModel.Win32Exception] -and $e.NativeErrorCode -eq 1223) -or $e.Message -match 'cancell?ed by the user') { return $true }
    $e = $e.InnerException
  }
  $false
}
$sig = Get-AuthenticodeSignature -FilePath $pkg
$cert = $sig.SignerCertificate
if (-not $cert) { 'MSIXRUN_RESULT=nocert'; exit 2 }
if ($expectedThumb -cnotmatch '^[0-9A-F]{40}$' -or $cert.Thumbprint -ne $expectedThumb -or @('UnknownError', 'NotTrusted') -notcontains [string]$sig.Status) { 'MSIXRUN_RESULT=changed'; exit 6 }
$cer = [IO.Path]::Combine([IO.Path]::GetTempPath(), 'msixrun-' + [guid]::NewGuid().ToString('N') + '.cer')
$result = 'ok'; $msg = ''
try {
  [IO.File]::WriteAllBytes($cer, $cert.RawData)
  $inner = '$ErrorActionPreference = ''Stop''; try { $c = New-Object Security.Cryptography.X509Certificates.X509Certificate2 (,''' + (Q $cer) + '''); if ($c.Thumbprint -ne ''' + $expectedThumb + ''') { exit 1 }; $s = New-Object Security.Cryptography.X509Certificates.X509Store ''TrustedPeople'', ''LocalMachine''; $s.Open(''ReadWrite''); try { $s.Add($c) } finally { $s.Close() } } catch { exit 1 }'
  $enc = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($inner))
  # Full path: a relative name is looked up in the current directory first.
  $root = $env:SystemRoot; if (-not $root) { $root = 'C:\Windows' }
  $psexe = [IO.Path]::Combine($root, 'System32\WindowsPowerShell\v1.0\powershell.exe')
  try {
    $p = Start-Process -FilePath $psexe -Verb RunAs -Wait -PassThru -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-EncodedCommand',$enc)
    if ($p.ExitCode -ne 0) { $result = 'failed'; $msg = 'the elevated import exited with code ' + $p.ExitCode }
  } catch {
    if (Declined $_.Exception) { $result = 'declined' } else { $result = 'failed'; $msg = ($_.Exception.Message -replace '\s+', ' ') }
  }
} catch {
  $result = 'failed'; $msg = ($_.Exception.Message -replace '\s+', ' ')
} finally {
  Remove-Item -LiteralPath $cer -Force -ErrorAction SilentlyContinue
}
if ($result -eq 'ok' -and -not (Test-Path ('Cert:\LocalMachine\TrustedPeople\' + $cert.Thumbprint))) { $result = 'unverified' }
'MSIXRUN_RESULT=' + $result
if ($msg) { 'MSIXRUN_MESSAGE=' + $msg }
exit @{ ok = 0; declined = 3; failed = 4; unverified = 5 }[$result]
PS
}

ps_devmode() {
  cat <<'PS'
# step: devmode
$v = $null
try { $v = (Get-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock' -ErrorAction Stop).AllowDevelopmentWithoutDevLicense } catch {}
'DEVMODE=' + $(if ($v -eq 1) { 1 } else { 0 })
$cmd = Get-Command Add-AppxPackage -ErrorAction SilentlyContinue
'ALLOWUNSIGNED=' + $(if ($cmd -and $cmd.Parameters.ContainsKey('AllowUnsigned')) { 1 } else { 0 })
PS
}

ps_conflict() {
  ps_id_fn
  cat <<'PS'
# step: conflict
$ErrorActionPreference = 'Stop'
$i = Get-MsixId $pkg
$old = @(Get-AppxPackage -Name $i.Name | Where-Object { $_.Name -eq $i.Name -and $_.Publisher -ne $i.Publisher })
'CONFLICT=' + $old.Count
PS
}

ps_remove() {
  ps_id_fn
  cat <<'PS'
# step: remove
$ErrorActionPreference = 'Stop'
try {
  $i = Get-MsixId $pkg
  $old = @(Get-AppxPackage -Name $i.Name | Where-Object { $_.Name -eq $i.Name -and $_.Publisher -ne $i.Publisher })
  foreach ($o in $old) { Remove-AppxPackage -Package $o.PackageFullName }
  'REMOVED=' + $old.Count
} catch {
  'MSIXRUN_MESSAGE=' + ($_.Exception.Message -replace '\s+', ' ')
  exit 1
}
PS
}

ps_launch() {
  ps_id_fn
  cat <<'PS'
# step: launch
$ErrorActionPreference = 'Stop'
$i = Get-MsixId $pkg
$p = Get-AppxPackage -Name $i.Name | Sort-Object { [version]$_.Version } | Select-Object -Last 1
if (-not $p) { throw 'package not found after install' }
$id = @((Get-AppxPackageManifest $p).Package.Applications.Application)[0].Id
if (-not $id) { throw 'package declares no launchable application' }
$p.PackageFamilyName + '!' + $id
PS
}

# Run a snippet against the package. $1 = snippet function, $2 = extra
# assignment line (optional). Output is captured in $out, status in $rc.
out="" rc=0
run_ps() {
  local script
  script="\$pkg = '$(psq "$winpath")'"$'\n'"${2:-}"$'\n'"$("$1")"
  if out="$(ps "$script" 2>&1)"; then rc=0; else rc=$?; fi
}

# Value of a KEY=value line from $out.
field() { printf '%s\n' "$out" | sed -n "s/^$1=//p" | head -n 1; }

# ---- arguments ----

src="" launch=1 trust=0 yes=0
for arg in "$@"; do
  case "$arg" in
    -h|--help)   usage; exit 0 ;;
    --version)   echo "msixrun $VERSION"; exit 0 ;;
    --no-launch) launch=0 ;;
    --trust)     trust=1 ;;
    -y|--yes)    yes=1 ;;
    -*)          die "unknown option: $arg (try --help)" ;;
    *)           [ -z "$src" ] || die "only one package allowed"; src="$arg" ;;
  esac
done

[ -n "$src" ] || { usage >&2; exit 1; }
command -v powershell.exe >/dev/null 2>&1 || die "powershell.exe not found (run this on Windows: Git Bash, MSYS2 or WSL)"

has_pkg_ext() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    *.msix|*.msixbundle|*.appx|*.appxbundle) return 0 ;;
    *) return 1 ;;
  esac
}

# ---- consent ----

tty_path="${MSIXRUN_TTY:-/dev/tty}"
tty_open=0
can_prompt() {
  [ "$tty_open" -eq 1 ] && return 0
  if { exec 9<"$tty_path"; } 2>/dev/null; then tty_open=1; return 0; fi
  return 1
}

# confirm <prompt> <switch that already answers yes: trust|yes>
# 0 = yes, 1 = no, 2 = cannot ask (no terminal, no switch)
confirm() {
  if [ "$yes" -eq 1 ]; then echo "$1 y (--yes)" >&2; return 0; fi
  if [ "$2" = trust ] && [ "$trust" -eq 1 ]; then echo "$1 y (--trust)" >&2; return 0; fi
  can_prompt || return 2
  local ans=""
  printf '%s ' "$1" >&2
  IFS= read -r ans <&9 || ans=""
  case "$ans" in y|Y|yes|YES|Yes) return 0 ;; *) return 1 ;; esac
}

# ---- 1. get the package ----

tmpdir=""
cleanup() { [ -z "$tmpdir" ] || rm -rf "$tmpdir"; }
trap cleanup EXIT

make_tmpdir() {
  [ -z "$tmpdir" ] || return 0
  local base="${TMPDIR:-/tmp}" wt
  if ! command -v cygpath >/dev/null 2>&1 && command -v wslpath >/dev/null 2>&1; then
    # WSL: keep the files on the Windows side so Add-AppxPackage can read them.
    wt="$(ps '[IO.Path]::GetTempPath()' 2>/dev/null)" || wt=""
    [ -z "$wt" ] || base="$(wslpath -u "$wt" 2>/dev/null || echo "$base")"
  fi
  tmpdir="$(mktemp -d "${base%/}/msixrun.XXXXXX")" || die "could not create a temp directory"
}

case "$src" in
  http://*|https://*)
    command -v curl >/dev/null 2>&1 || die "curl is required to download a package URL"
    make_tmpdir
    name="${src%%[?#]*}"; name="${name##*/}"
    name="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_')"
    has_pkg_ext "$name" || name="download.msix"
    file="$tmpdir/$name"
    echo "Downloading $src ..."
    curl -fsSL -o "$file" "$src" || die "download failed: $src"
    ;;
  *)
    file="$src"
    [ -f "$file" ] || die "file not found: $file"
    has_pkg_ext "$file" || die "expected a .msix, .msixbundle, .appx or .appxbundle file: $file"
    # Add-AppxPackage -Path and Get-AuthenticodeSignature -FilePath treat
    # [ ] * ? as wildcards and ` as the escape character, so work from a
    # plain copy.
    case "$file" in
      *[][*?\`]*)
        make_tmpdir
        copy="$tmpdir/$(printf '%s' "${file##*/}" | tr -c 'A-Za-z0-9._-' '_')"
        cp -- "$file" "$copy" || die "could not copy $file to a temp directory"
        file="$copy"
        ;;
    esac
    ;;
esac

# Convert to a Windows path.
if command -v cygpath >/dev/null 2>&1; then
  winpath="$(cygpath -w "$file")"
elif command -v wslpath >/dev/null 2>&1; then
  winpath="$(wslpath -w "$file")"
else
  die "need cygpath (Git Bash/MSYS2) or wslpath (WSL) to convert the path"
fi

# ---- 2. read the package identity from the manifest (the package is a zip) ----

echo "Reading package manifest..."
run_ps ps_manifest
[ "$rc" -eq 0 ] || die "could not read the package manifest: $out"
pkgname="$(field NAME)"
[ -n "$pkgname" ] || die "could not determine package name from manifest"
case "$pkgname" in
  *[!A-Za-z0-9.-]*) die "refusing a package name with unexpected characters" ;;
esac
echo "Package: $pkgname"

# ---- 3. install, with one fix per known problem ----

allow_unsigned=0
msg=""
in_out() { printf '%s\n' "$out" | grep -qiE "$1"; }
fcode="" ecode=""

# Failures are classified on the deployment HRESULT that Windows prints in its
# message ("Deployment failed with HRESULT: 0x..."), after the package path and
# file name are removed from the text (a file named 0x80073CFB.msix must not
# look like an error code). Only when the message holds no HRESULT at all does
# the wording decide. The exception's own HResult (MSIXRUN_HRESULT) is not the
# deployment HRESULT, so it is used only when the message has no code.
UNTRUSTED_CODES=" 0X800B0109 0X800B010A 0X800B0112 0X800B0004 "
UNTRUSTED_WORDING='root certificate of the signature|chain.*cannot be built'
UNSIGNED_CODES=" 0X800B0100 "
UNSIGNED_WORDING='must be digitally signed|not signed'
# Only 0x80073CFB means another publisher's copy is in the way. Any other
# failure (disk full, bad dependency, corrupt package) must never lead to a
# removal. 0x80073CF3 is Windows' generic "failed dependency or conflict
# validation" code (a missing framework returns it too), so it counts only when
# the message also says the package conflicts. A bare 0x80073CF3 never leads to
# a removal.
CONFLICT_CODE="0X80073CFB"
GENERIC_FAILURE_CODE="0X80073CF3"
CONFLICT_WORDING='conflicts with|different publisher|another publisher'

# Remove every spelling of the package's path and file name from stdin.
strip_pkg() {
  P1="$winpath" P2="${winpath//\\//}" P3="${winpath##*\\}" awk '
    function strip(s, p,   i, l) {
      l = length(p); if (l == 0) return s
      while ((i = index(tolower(s), tolower(p))) > 0) s = substr(s, 1, i - 1) "<package>" substr(s, i + l)
      return s
    }
    { $0 = strip($0, ENVIRON["P1"]); $0 = strip($0, ENVIRON["P2"]); $0 = strip($0, ENVIRON["P3"]); print }'
}

# The deployment HRESULT in a text, upper case: the one after "HRESULT:" if
# any, else the first 0x........ token, else nothing.
failure_code() {
  local t="$1" c
  c="$(printf '%s\n' "$t" | grep -oiE 'HRESULT:? *0x[0-9A-Fa-f]{8}' | head -n 1 | grep -oiE '0x[0-9A-Fa-f]{8}')" || c=""
  [ -n "$c" ] || c="$(printf '%s\n' "$t" | grep -oE '0x[0-9A-Fa-f]{8}' | head -n 1)" || c=""
  printf '%s' "$c" | tr '[:lower:]' '[:upper:]'
}

# failure_is <codes> <wording>: does $fcode (or, with no code, $msg) match?
failure_is() {
  if [ -n "$fcode" ]; then case "$1" in *" $fcode "*) return 0 ;; *) return 1 ;; esac; fi
  if [ -n "$ecode" ]; then case "$1" in *" $ecode "*) return 0 ;; esac; fi
  printf '%s\n' "$msg" | grep -qiE "$2"
}
is_conflict() {
  local c="$fcode"
  # No code in the message: the exception's HResult counts only if it is itself a conflict code.
  [ -n "$c" ] || case "$ecode" in "$CONFLICT_CODE"|"$GENERIC_FAILURE_CODE") c="$ecode" ;; esac
  [ "$c" = "$CONFLICT_CODE" ] && return 0
  [ "$c" = "$GENERIC_FAILURE_CODE" ] && printf '%s\n' "$msg" | grep -qiE "$CONFLICT_WORDING"
}

trust_done=0 unsigned_done=0 conflict_done=0
while :; do
  echo "Installing $winpath ..."
  run_ps ps_install "\$allowUnsigned = [bool]$allow_unsigned"
  if [ "$rc" -eq 0 ] && in_out '^MSIXRUN_OK'; then break; fi
  msg="$(field MSIXRUN_MESSAGE)"; [ -n "$msg" ] || msg="$(printf '%s\n' "$out" | grep -v '^MSIXRUN_HRESULT=')"
  msg="$(printf '%s\n' "$msg" | strip_pkg)"
  fcode="$(failure_code "$msg")"
  ecode="$(failure_code "$(field MSIXRUN_HRESULT)")"

  # 3a. The publisher is not trusted.
  if [ "$trust_done" -eq 0 ] && failure_is "$UNTRUSTED_CODES" "$UNTRUSTED_WORDING"; then
    run_ps ps_signer
    status="$(field STATUS)"
    subject="$(field SUBJECT)"; thumb="$(field THUMBPRINT)"; notafter="$(field NOTAFTER)"
    if [ -z "$thumb" ]; then
      die "Windows does not trust this package's publisher, and msixrun could not read the signer certificate: $msg"
    fi
    # Only a valid signature with an untrusted chain is offered for trust.
    case "$status" in
      UnknownError|NotTrusted) ;;
      *) die "the package's signature is not valid (status: ${status:-unknown}), so msixrun will not offer to trust it. Get a fresh copy of the package. $msg" ;;
    esac
    # The thumbprint that is shown and later checked must be plain SHA-1 hex.
    case "$thumb" in
      *[!0-9A-F]*) die "the signer's thumbprint is not plain hex, so msixrun will not offer to trust it" ;;
    esac
    [ "${#thumb}" -eq 40 ] || die "the signer's thumbprint is not 40 hex characters, so msixrun will not offer to trust it"
    {
      echo
      echo "Signer:      $subject"
      echo "Thumbprint:  $thumb (SHA-1)"
      echo "Valid until: $notafter"
    } >&2
    if confirm "Windows does not trust the publisher of this package. Trust $subject and install? [y/N]" trust; then
      echo "Windows will ask for permission once (UAC)." >&2
      # The trust step reads the signer again and acts only on this thumbprint.
      run_ps ps_trust "\$expectedThumb = '$thumb'"
      case "$(field MSIXRUN_RESULT)" in
        ok) echo "Trusted $subject on this PC (Local Machine, Trusted People)." >&2 ;;
        declined) die "permission was declined, so $subject was not trusted. Nothing was changed." ;;
        nocert) die "the package has no signer certificate to trust" ;;
        changed) die "the package's signer is no longer the one you were shown, so nothing was trusted. Get a fresh copy of the package." ;;
        unverified) die "the certificate import ran but the thumbprint is not in Trusted People. Nothing was installed." ;;
        *) die "could not trust the certificate: $(field MSIXRUN_MESSAGE)" ;;
      esac
      trust_done=1
      continue
    else
      case $? in
        2) die "Windows does not trust the publisher of this package ($subject) and there is no terminal to ask. Re-run with --trust to trust this publisher, or --yes to answer yes to everything." ;;
        *) die "not installed: you chose not to trust $subject" ;;
      esac
    fi
  fi

  # 3b. The package is not signed at all.
  if [ "$unsigned_done" -eq 0 ] && failure_is "$UNSIGNED_CODES" "$UNSIGNED_WORDING"; then
    run_ps ps_devmode
    devmode="$(field DEVMODE)"; canunsigned="$(field ALLOWUNSIGNED)"
    if [ "$devmode" = 1 ] && [ "$canunsigned" = 1 ]; then
      if confirm "This package is not signed. Developer Mode is on, so it can be installed unsigned. Install it anyway? [y/N]" yes; then
        allow_unsigned=1; unsigned_done=1
        continue
      else
        case $? in
          2) die "this package is not signed. Re-run with --yes to install it unsigned (Developer Mode is on)." ;;
          *) die "not installed: you chose not to install an unsigned package" ;;
        esac
      fi
    elif [ "$devmode" = 1 ]; then
      die "this package is not signed, and this version of Windows cannot install unsigned packages. Sign it, or use a newer Windows build."
    else
      cat >&2 <<HINT
msixrun: this package is not signed, and Developer Mode is off.
Turn Developer Mode on, then run this again:
  Windows 11: Settings > System > For developers > Developer Mode
  Windows 10: Settings > Update & Security > For developers > Developer Mode
HINT
      exit 1
    fi
  fi

  # 3c. An older copy from a different publisher is in the way.
  if [ "$conflict_done" -eq 0 ] && is_conflict; then
    run_ps ps_conflict
    if [ "$(field CONFLICT)" -gt 0 ] 2>/dev/null; then
      if confirm "An older $pkgname from a different publisher is installed. Remove it and install this one? Its local data will be removed. [y/N]" yes; then
        run_ps ps_remove
        [ "$rc" -eq 0 ] || die "could not remove the older $pkgname: $(field MSIXRUN_MESSAGE)"
        conflict_done=1
        continue
      else
        case $? in
          2) die "an older $pkgname from a different publisher is installed. Re-run with --yes to remove it (its local data is removed) and install this one." ;;
          *) die "not installed: you chose to keep the older $pkgname" ;;
        esac
      fi
    fi
  fi

  echo "msixrun: install failed: $msg" >&2
  exit 1
done

if [ "$launch" -ne 1 ]; then echo "Installed $pkgname."; exit 0; fi

# ---- 4. look up PackageFamilyName and the first app Id, then launch ----

run_ps ps_launch
[ "$rc" -eq 0 ] || die "installed, but could not find the app to launch: $out"
info="$(printf '%s\n' "$out" | tail -n 1)"
case "$info" in
  ""|*[!A-Za-z0-9._!-]*|!*|*!) die "installed, but could not resolve PackageFamilyName!AppId" ;;
esac

echo "Launching $info"
# explorer.exe often returns a nonzero exit code even on success.
# Prefer the full path under %SystemRoot%: a bare name could be a planted file.
explorer="explorer.exe"
if [ -n "${SYSTEMROOT:-}" ]; then
  if command -v cygpath >/dev/null 2>&1; then sysroot="$(cygpath -u "$SYSTEMROOT" 2>/dev/null)" || sysroot=""
  elif command -v wslpath >/dev/null 2>&1; then sysroot="$(wslpath -u "$SYSTEMROOT" 2>/dev/null)" || sysroot=""
  else sysroot=""; fi
  [ -z "$sysroot" ] || [ ! -x "$sysroot/explorer.exe" ] || explorer="$sysroot/explorer.exe"
fi
"$explorer" "shell:AppsFolder\\$info" || true
